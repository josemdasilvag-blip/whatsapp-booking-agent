# Agente de reservas por WhatsApp - credenciales
# ESTE FICHERO NO SE SUBE A GITHUB NUNCA. Ya esta en .gitignore.
# Sustituye lo que hay despues del =
# No pongas comillas. No dejes espacios alrededor del =

WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Esta ya esta rellena. No la toques.
WEBHOOK_VERIFY_TOKEN=

# Capa de interpretacion (opcional). Sin esto el agente funciona igual, solo
# que sin entender el texto libre: repregunta en vez de interpretar.
ANTHROPIC_API_KEY=
MODELO_INTERPRETE=claude-haiku-4-5-20251001
TIMEOUT_INTERPRETE=8
